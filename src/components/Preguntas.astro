---
import { config } from '../config';
import { cartas } from '../data/preguntas';
import IconoTulipan from './IconoTulipan.astro';

const romanos = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV'];
// Pequeña inclinación de cada sobre para que parezcan puestos a mano sobre una mesa
const giros = [-1.6, 1.2, -0.6, 1.8, -1.2, 0.8, -1.8, 1.4, -0.8, 1];
---

<section class="preguntas" aria-labelledby="titulo-preguntas">
  <h2 id="titulo-preguntas">Cartas para ti</h2>
  <p class="intro-cartas">Cada sobre guarda una pregunta. Ábrelos y respóndeme con el corazón.</p>

  <ul class="sobres">
    {cartas.map((c, i) => (
      <li>
        <button
          type="button"
          class="sobre"
          data-i={i}
          style={`--giro:${giros[i % giros.length]}deg`}
          aria-label={`Abrir carta ${i + 1}: ${c.asunto}`}
        >
          <span class="interior" aria-hidden="true"></span>
          <span class="hoja" aria-hidden="true"></span>
          <span class="bolsillo" aria-hidden="true"><span class="forma"></span></span>
          <span class="texto" aria-hidden="true">
            <span class="rotulo">Asunto</span>
            <span class="asunto">{c.asunto}</span>
          </span>
          <span class="solapa" aria-hidden="true"><span class="forma"></span></span>
          <span class="sello" aria-hidden="true">{romanos[i] ?? i + 1}</span>
          <span class="estampilla" aria-hidden="true">Respondida</span>
        </button>
      </li>
    ))}
  </ul>

  <div class="enviar">
    <p id="progreso"></p>
    <button type="button" id="enviar-respuestas" class="boton-oro" disabled>Enviarle mis respuestas</button>
  </div>

  <div class="diario" id="diario" hidden>
    <h3 class="diario-titulo">Nuestras cartas</h3>
    <p class="diario-intro">Todo lo que me has respondido queda guardado aquí.</p>
    <ol class="entradas" id="entradas"></ol>
  </div>

  <p class="aviso" id="aviso" role="status" aria-live="polite"></p>

  <dialog id="dialogo-carta" aria-labelledby="dialogo-asunto">
    <form method="dialog">
      <header class="membrete">
        <span class="sello-carta" aria-hidden="true"><IconoTulipan size={30} /></span>
        <p class="numero" id="dialogo-numero"></p>
        <p class="etiqueta-asunto"><span>Asunto:</span> <strong id="dialogo-asunto"></strong></p>
      </header>
      <p class="nota" id="dialogo-nota"></p>
      <h3 id="dialogo-pregunta"></h3>
      <label class="sr" for="dialogo-respuesta">Tu respuesta</label>
      <textarea id="dialogo-respuesta" rows="6" placeholder="Escribe aquí, mi amor…"></textarea>
      <div class="acciones">
        <button type="submit" value="cerrar" class="boton-suave">Cerrar</button>
        <button type="submit" value="guardar" class="boton-oro">Guardar</button>
      </div>
    </form>
  </dialog>
</section>

<script define:vars={{ cartas, whatsapp: config.whatsapp, nombre: config.nombre, hoja: config.hojaRespuestas }}>
  const CLAVE = 'respuestas-karito';
  const CLAVE_PENDIENTES = 'respuestas-karito-pendientes';
  const CLAVE_FECHAS = 'respuestas-karito-fechas';
  const leer = (clave, vacio) => {
    try { return JSON.parse(localStorage.getItem(clave) || vacio); } catch { return JSON.parse(vacio); }
  };
  const escribir = (clave, datos) => {
    try { localStorage.setItem(clave, JSON.stringify(datos)); } catch {}
  };

  let respuestas = leer(CLAVE, '{}');
  let fechas = leer(CLAVE_FECHAS, '{}');
  let actual = -1;
  let sobreAbierto = null;

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const romanos = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV'];
  const dialogo = document.getElementById('dialogo-carta');
  const campo = document.getElementById('dialogo-respuesta');
  const enviar = document.getElementById('enviar-respuestas');
  const progreso = document.getElementById('progreso');
  const aviso = document.getElementById('aviso');
  const diario = document.getElementById('diario');
  const entradas = document.getElementById('entradas');

  let temporizadorAviso;
  function avisar(texto) {
    aviso.textContent = texto;
    aviso.classList.add('visible');
    clearTimeout(temporizadorAviso);
    temporizadorAviso = setTimeout(() => aviso.classList.remove('visible'), 3200);
  }

  // Envía la respuesta a tu hoja de cálculo. Si no hay internet, queda pendiente y se reintenta.
  async function enviarAHoja(registro) {
    if (!hoja) return 'local';
    try {
      await fetch(hoja, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(registro),
      });
      return 'enviada';
    } catch {
      const pendientes = leer(CLAVE_PENDIENTES, '[]');
      pendientes.push(registro);
      escribir(CLAVE_PENDIENTES, pendientes);
      return 'pendiente';
    }
  }

  async function reintentarPendientes() {
    const pendientes = leer(CLAVE_PENDIENTES, '[]');
    if (!hoja || pendientes.length === 0) return;
    escribir(CLAVE_PENDIENTES, []);
    for (const registro of pendientes) await enviarAHoja(registro);
  }

  function pintar() {
    document.querySelectorAll('.sobre').forEach((sobre) => {
      sobre.classList.toggle('respondida', Boolean(respuestas[sobre.dataset.i]?.trim()));
    });
    const total = cartas.filter((_, i) => respuestas[i]?.trim()).length;
    progreso.textContent = `Has respondido ${total} de ${cartas.length} cartas`;
    enviar.disabled = total === 0;
    pintarDiario();
  }

  // "Nuestras cartas": todas sus respuestas juntas, como un diario
  function pintarDiario() {
    const crear = (etiqueta, clase, texto) => {
      const el = document.createElement(etiqueta);
      if (clase) el.className = clase;
      if (texto) el.textContent = texto;
      return el;
    };
    entradas.replaceChildren();
    cartas.forEach((carta, i) => {
      const texto = respuestas[i]?.trim();
      if (!texto) return;
      const entrada = crear('li', 'entrada');
      const cabecera = crear('div', 'entrada-cabecera');
      cabecera.append(
        crear('span', 'entrada-numero', `Carta ${romanos[i] ?? i + 1}`),
        crear('span', 'entrada-asunto', carta.asunto)
      );
      entrada.append(cabecera, crear('p', 'entrada-pregunta', carta.pregunta), crear('p', 'entrada-respuesta', texto));
      const pie = crear('div', 'entrada-pie');
      if (fechas[i]) {
        const fecha = new Date(fechas[i]).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
        pie.append(crear('span', 'entrada-fecha', `Escrita el ${fecha}`));
      }
      const editar = crear('button', 'entrada-editar', 'Releer o editar');
      editar.type = 'button';
      editar.addEventListener('click', () => {
        const sobre = document.querySelector(`.sobre[data-i="${i}"]`);
        sobre.scrollIntoView({ behavior: sinMovimiento ? 'auto' : 'smooth', block: 'center' });
        setTimeout(() => sobre.click(), sinMovimiento ? 0 : 550);
      });
      pie.append(editar);
      entrada.append(pie);
      entradas.append(entrada);
    });
    diario.hidden = entradas.children.length === 0;
  }

  document.querySelectorAll('.sobre').forEach((sobre) => {
    sobre.addEventListener('click', () => {
      if (sobreAbierto) return;
      sobreAbierto = sobre;
      actual = Number(sobre.dataset.i);
      const carta = cartas[actual];
      document.getElementById('dialogo-numero').textContent = `Carta ${romanos[actual] ?? actual + 1}`;
      document.getElementById('dialogo-asunto').textContent = carta.asunto;
      document.getElementById('dialogo-nota').textContent = carta.nota;
      document.getElementById('dialogo-pregunta').textContent = carta.pregunta;
      campo.value = respuestas[actual] || '';

      // Se rompe el sello, se abre la solapa, sale la hoja… y se despliega la carta
      sobre.classList.add('abriendo');
      setTimeout(() => dialogo.showModal(), sinMovimiento ? 0 : 1450);
    });
  });

  dialogo.addEventListener('close', async () => {
    // La hoja vuelve a entrar y el sobre se cierra
    if (sobreAbierto) {
      const sobre = sobreAbierto;
      sobre.classList.remove('abriendo');
      setTimeout(() => { sobreAbierto = null; }, sinMovimiento ? 0 : 1200);
      sobre.focus({ preventScroll: true });
    }

    if (dialogo.returnValue !== 'guardar' || actual < 0) return;
    const texto = campo.value.trim();
    const cambio = texto !== (respuestas[actual] || '').trim();
    respuestas[actual] = campo.value;
    escribir(CLAVE, respuestas);
    if (cambio) {
      fechas[actual] = new Date().toISOString();
      escribir(CLAVE_FECHAS, fechas);
    }
    pintar();
    if (!texto || !cambio) return;

    const carta = cartas[actual];
    const estado = await enviarAHoja({
      carta: actual + 1,
      asunto: carta.asunto,
      pregunta: carta.pregunta,
      respuesta: texto,
      fecha: new Date().toISOString(),
    });
    avisar(
      estado === 'pendiente'
        ? 'Tu respuesta quedó guardada. Me llegará cuando tengas internet.'
        : 'Tu respuesta quedó guardada.'
    );
  });

  // Cerrar tocando fuera de la carta
  dialogo.addEventListener('click', (e) => {
    if (e.target === dialogo) dialogo.close('cerrar');
  });

  enviar.addEventListener('click', () => {
    const lineas = cartas
      .map((c, i) => (respuestas[i]?.trim() ? `*${i + 1}. ${c.asunto}*\n_${c.pregunta}_\n${respuestas[i].trim()}` : null))
      .filter(Boolean);
    const texto = `Mis respuestas a tus cartas, con amor, ${nombre}:\n\n${lineas.join('\n\n')}`;
    const url = `https://wa.me/${whatsapp}?text=${encodeURIComponent(texto)}`;
    window.open(url, '_blank', 'noopener');
  });

  pintar();
  reintentarPendientes();
  window.addEventListener('online', reintentarPendientes);
</script>

<style>
  .preguntas {
    --papel: #fbf3e2;
    --papel-sombra: #f1e3c4;
    --papel-oscuro: #e6d3a8;
    --linea-oro: rgba(184, 146, 40, 0.45);
    --alto-solapa: 52%;
    --pico-bolsillo: 44%;

    width: min(100% - 32px, 960px);
    margin: 0 auto 4rem;
    text-align: center;
  }
  h2 {
    font-family: var(--manuscrita);
    font-weight: 400;
    font-size: clamp(2.4rem, 9vw, 3.2rem);
    color: var(--rosa-fuerte);
  }
  .intro-cartas { max-width: 460px; margin: 0.3rem auto 2.4rem; color: var(--texto-suave); }

  /* ---------- Rejilla de sobres ---------- */
  .sobres {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 2rem 1.4rem;
  }

  /* ---------- El sobre ---------- */
  .sobre {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    perspective: 900px;
    transform: rotate(var(--giro));
    transition: transform 0.35s ease;
  }
  .sobre > span { position: absolute; }

  /* Parte de adentro (se ve cuando se abre la solapa) */
  .interior {
    inset: 0;
    border-radius: 6px;
    background: linear-gradient(180deg, var(--papel-oscuro), var(--papel-sombra));
    box-shadow: 0 10px 24px rgba(30, 58, 95, 0.12), 0 2px 4px rgba(30, 58, 95, 0.08);
  }

  /* La hoja de la carta, guardada adentro */
  .hoja {
    left: 7%;
    right: 7%;
    top: 7%;
    bottom: 6%;
    z-index: 2;
    border-radius: 3px;
    background:
      repeating-linear-gradient(180deg, transparent 0 13px, rgba(142, 205, 240, 0.55) 13px 14px) 0 22px / 100% calc(100% - 22px) no-repeat,
      #fffef9;
    box-shadow: 0 1px 3px rgba(30, 58, 95, 0.15);
    transition: transform 0.5s cubic-bezier(0.5, 0, 0.75, 0);
  }

  /* Bolsillo delantero: las dos solapas laterales y la de abajo */
  .bolsillo {
    inset: 0;
    z-index: 3;
    filter: drop-shadow(0 -1px 0 var(--linea-oro));
  }
  .bolsillo .forma {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    clip-path: polygon(0 0, 50% var(--pico-bolsillo), 100% 0, 100% 100%, 0 100%);
    background:
      linear-gradient(to top right, transparent calc(50% - 0.6px), rgba(184, 146, 40, 0.18) 50%, transparent calc(50% + 0.6px)) left bottom / 50% 40% no-repeat,
      linear-gradient(to top left, transparent calc(50% - 0.6px), rgba(184, 146, 40, 0.18) 50%, transparent calc(50% + 0.6px)) right bottom / 50% 40% no-repeat,
      linear-gradient(180deg, var(--papel-sombra), var(--papel));
  }

  /* La pregunta, escrita sobre el sobre */
  .texto {
    left: 8%;
    right: 8%;
    bottom: 5%;
    top: 67%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    color: var(--texto);
    transition: opacity 0.3s ease 0.9s;
  }
  .rotulo {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #a8862a;
  }
  .asunto {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.2;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--linea-oro);
  }

  /* Solapa superior que se abre */
  .solapa {
    left: 0;
    right: 0;
    top: 0;
    height: var(--alto-solapa);
    z-index: 5;
    transform-origin: top center;
    filter: drop-shadow(0 2px 2px rgba(120, 90, 20, 0.18));
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.45s, z-index 0s 0.75s;
  }
  .solapa .forma {
    position: absolute;
    inset: 0;
    border-radius: 6px 6px 0 0;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    background: linear-gradient(180deg, #fdf7ea, var(--papel-sombra));
  }

  /* Sello de cera dorado en la punta de la solapa */
  .sello {
    left: 50%;
    top: var(--alto-solapa);
    z-index: 6;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #7d5e0c;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff1c9, var(--dorado-suave) 50%, var(--dorado) 85%);
    box-shadow:
      0 0 0 3px rgba(212, 175, 55, 0.35),
      0 4px 10px rgba(140, 100, 10, 0.35),
      inset 0 -2px 4px rgba(140, 100, 10, 0.3);
    transform: translate(-50%, -50%);
    transition: transform 0.35s ease 1.05s, opacity 0.35s ease 1.05s;
  }

  /* Estampilla rosa cuando ya respondió */
  .estampilla {
    top: 8%;
    right: 5%;
    z-index: 7;
    padding: 0.2rem 0.45rem;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rosa-fuerte);
    border: 1.5px dashed var(--rosa-fuerte);
    border-radius: 4px;
    background: rgba(253, 224, 234, 0.9);
    transform: rotate(9deg) scale(0);
    transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .sobre.respondida .estampilla { transform: rotate(9deg) scale(1); }

  /* ---------- Animación de apertura ---------- */
  .sobre.abriendo { z-index: 10; transform: rotate(0deg) scale(1.04); }
  .sobre.abriendo .sello {
    transform: translate(-50%, -50%) scale(1.35) rotate(-12deg);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }
  .sobre.abriendo .solapa {
    transform: rotateX(180deg);
    z-index: 1;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.25s, z-index 0s 0.55s;
  }
  .sobre.abriendo .hoja {
    transform: translateY(-58%);
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1) 0.8s;
  }
  .sobre.abriendo .texto { opacity: 0.35; transition-delay: 0s; }
  .sobre.abriendo .estampilla { opacity: 0; }

  @media (hover: hover) {
    .sobre:not(.abriendo):hover { transform: rotate(0deg) translateY(-6px); }
    .sobre:not(.abriendo):hover .solapa { transform: rotateX(28deg); transition-delay: 0s; }
  }
  .sobre:focus-visible { outline: 2px solid var(--dorado); outline-offset: 6px; border-radius: 8px; }

  @media (prefers-reduced-motion: reduce) {
    .sobre * { transition-delay: 0s !important; }
  }

  /* ---------- Enviar respuestas ---------- */
  .enviar { margin-top: 2.6rem; display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
  #progreso { font-size: 0.9rem; color: var(--texto-suave); }

  .boton-oro, .boton-suave {
    font: 600 0.95rem var(--sans);
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--texto);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .boton-oro {
    border: 1.5px solid var(--dorado);
    background: linear-gradient(135deg, #fff9e6, var(--dorado-claro));
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
  }
  .boton-oro:disabled { opacity: 0.45; cursor: default; box-shadow: none; }
  .boton-suave { border: 1px solid var(--cielo-fuerte); background: var(--blanco); }
  @media (hover: hover) {
    .boton-oro:not(:disabled):hover, .boton-suave:hover { transform: translateY(-2px); }
  }

  /* ---------- Nuestras cartas ---------- */
  .diario {
    width: min(100%, 640px);
    margin: 3.4rem auto 0;
  }
  .diario-titulo {
    font-family: var(--manuscrita);
    font-weight: 400;
    font-size: clamp(2.1rem, 8vw, 2.7rem);
    color: var(--rosa-fuerte);
  }
  .diario-intro { margin: 0.2rem 0 1.6rem; color: var(--texto-suave); }
  .entradas {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    text-align: left;
  }
  .entradas :global(.entrada) {
    padding: 1.2rem clamp(1rem, 4vw, 1.6rem) 1rem;
    border-radius: 6px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-left: 4px solid var(--rosa);
    background: #fffef9;
    box-shadow: 0 8px 22px rgba(30, 58, 95, 0.07);
    animation: aparecer 0.5s ease;
  }
  @keyframes aparecer { from { opacity: 0; transform: translateY(10px); } }
  .entradas :global(.entrada-cabecera) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
  }
  .entradas :global(.entrada-numero) {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a8862a;
  }
  .entradas :global(.entrada-asunto) { font-family: var(--serif); font-style: italic; font-size: 1.1rem; }
  .entradas :global(.entrada-pregunta) {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }
  .entradas :global(.entrada-respuesta) {
    margin-top: 0.8rem;
    padding: 0 0.2rem;
    font-size: 1rem;
    line-height: 32px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: repeating-linear-gradient(180deg, transparent 0 31px, rgba(142, 205, 240, 0.55) 31px 32px);
  }
  .entradas :global(.entrada-pie) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .entradas :global(.entrada-fecha) { font-size: 0.8rem; font-style: italic; color: var(--texto-suave); }
  .entradas :global(.entrada-editar) {
    margin-left: auto;
    font: 600 0.82rem var(--sans);
    color: var(--rosa-fuerte);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--rosa);
    background: #fff7fa;
    cursor: pointer;
  }
  @media (hover: hover) {
    .entradas :global(.entrada-editar:hover) { background: #fde0ea; }
  }

  .aviso {
    position: fixed;
    left: 50%;
    bottom: calc(1.4rem + env(safe-area-inset-bottom));
    z-index: 50;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 0.75rem 1.3rem;
    font-size: 0.92rem;
    color: var(--texto);
    border-radius: 999px;
    border: 1px solid var(--dorado);
    background: linear-gradient(135deg, #fffdf6, var(--dorado-claro));
    box-shadow: 0 10px 30px rgba(30, 58, 95, 0.18);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 20px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .aviso.visible { opacity: 1; transform: translate(-50%, 0); }

  /* ---------- La carta abierta: papel de renglones que se despliega ---------- */
  dialog {
    width: min(100% - 32px, 480px);
    max-height: 92dvh;
    margin: auto;
    padding: 1.4rem clamp(1.1rem, 5vw, 1.8rem);
    overflow-y: auto;
    color: var(--texto);
    text-align: center;
    border: 1px solid rgba(212, 175, 55, 0.5);
    border-radius: 6px;
    background:
