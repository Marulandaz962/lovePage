---
import { frases } from '../data/frases';
---

<section class="frase-dia" aria-labelledby="titulo-frase">
  <h2 id="titulo-frase">Tu frase de hoy</h2>
  <p class="fecha" id="fecha-hoy"></p>
  <blockquote>
    <span class="comilla" aria-hidden="true">“</span>
    <p id="frase-hoy">{frases[0]}</p>
  </blockquote>
  <p class="mañana">Mañana te espera otra</p>
</section>

<script define:vars={{ frases }}>
  const hoy = new Date();
  // Días desde el 1 de enero de 2026 en la hora local de ella: cambia a medianoche
  const indice = Math.floor(
    (Date.UTC(hoy.getFullYear(), hoy.getMonth(), hoy.getDate()) - Date.UTC(2026, 0, 1)) / 86400000
  );
  document.getElementById('frase-hoy').textContent =
    frases[((indice % frases.length) + frases.length) % frases.length];

  const texto = hoy.toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long' });
  document.getElementById('fecha-hoy').textContent = texto.charAt(0).toUpperCase() + texto.slice(1);
</script>

<style>
  .frase-dia {
    position: relative;
    width: min(100% - 32px, 640px);
    margin: 2rem auto 4rem;
    padding: 2.6rem clamp(1.4rem, 5vw, 3rem) 2.2rem;
    text-align: center;
    border-radius: clamp(20px, 6vw, 28px);
    background:
      linear-gradient(var(--blanco), var(--blanco)) padding-box,
      linear-gradient(135deg, var(--dorado-suave), var(--cielo-fuerte), var(--dorado)) border-box;
    border: 2px solid transparent;
    box-shadow: 0 18px 50px rgba(30, 58, 95, 0.1);
  }
  h2 {
    font-family: var(--manuscrita);
    font-weight: 400;
    font-size: clamp(2.2rem, 8vw, 2.8rem);
    color: var(--rosa-fuerte);
  }
  .fecha {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dorado);
    font-weight: 600;
  }
  blockquote { position: relative; margin-top: 3rem; }
  .comilla {
    position: absolute;
    top: -2.4rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--serif);
    font-size: 5rem;
    color: var(--cielo);
    line-height: 1;
  }
  blockquote p {
    position: relative;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.15rem, 4.2vw, 1.45rem);
    line-height: 1.6;
  }
  .mañana {
    margin-top: 1.6rem;
    font-size: 0.85rem;
    color: var(--texto-suave);
  }
</style>
